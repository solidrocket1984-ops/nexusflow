{
  "name": "Activity",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "lead_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "llamada",
        "email",
        "reunion",
        "nota",
        "propuesta",
        "seguimiento",
        "otro"
      ]
    },
    "description": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "outcome": {
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "type",
    "description"
  ]
}